diff --git a/docs/kanban-deep-links.md b/docs/kanban-deep-links.md
new file mode 100644
index 00000000..49d4551d
--- /dev/null
+++ b/docs/kanban-deep-links.md
@@ -0,0 +1,17 @@
+# Kanban card links
+
+Open `/?panel=kanban&task=t_0123abcd` to show the Kanban panel and load that
+card's detail. `?task=t_0123abcd` is also accepted. `?panel=kanban` opens the
+board without selecting a card. Task IDs must be `t_` plus eight lowercase
+hexadecimal digits; malformed values are ignored, not treated as paths.
+
+The explicit URL takes precedence over a saved chat at boot. It does not
+modify the saved conversation or create a new chat. Missing/deleted cards
+use the existing Kanban error toast. The current Kanban board selection
+still applies; links do not switch boards or profiles.
+
+The existing login `next` redirect preserves the full path and query.
+No authentication bypass or backend route is added. `/kanban` is not a
+WebUI route (it is a route on the separate Hermes dashboard).
+
+Regression command: `node --test tests/kanban_deep_link.test.cjs`.
diff --git a/static/boot.js b/static/boot.js
index 06c3888d..439de96c 100644
--- a/static/boot.js
+++ b/static/boot.js
@@ -3748,6 +3748,12 @@ window._mirrorSpeechSettingsFromServer=_mirrorSpeechSettingsFromServer;
   const _srch = document.getElementById('sessionSearch'); if (_srch) _srch.value = '';
   if (typeof syncSessionSearchClear === 'function') syncSessionSearchClear();
   if(typeof refreshProviderQuotaIndicator==='function') refreshProviderQuotaIndicator();
+  // Explicit card links win over saved conversations and PWA chat actions.
+  if (typeof openKanbanDeepLink === 'function' && await openKanbanDeepLink()) {
